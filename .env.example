# NXT//LINK environment contract. Copy to .env.local for local dev; set the
# same names on each Vercel project (demo site vs. real site each get their
# OWN values — never share Supabase/keys between them).

# --- Supabase (REQUIRED) ---
# Project URL — also drives the CSP connect-src host in next.config.mjs.
NEXT_PUBLIC_SUPABASE_URL=
# Public/safe anon key (browser-exposed).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Powers the admin panel, demo logins, and vendor moderation. Server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site identity (REQUIRED) ---
# Canonical origin used in email links + OG metadata, REQUIRED per deployment.
NEXT_PUBLIC_SITE_URL=
# Site mode flag. Values: unset (real/production) | 'demo' (shows the non-dismissable demo banner in src/app/layout.tsx).
NEXT_PUBLIC_SITE_MODE=

# --- Admin access (REQUIRED) ---
# Comma-separated admin allowlist (case-insensitive emails); empty/unset = nobody is admin (fail-closed).
ADMIN_EMAILS=
# Shared code that unlocks the /admin AccessGate; compared server-side only.
ADMIN_ACCESS_CODE=
# Signs the admin session cookie; falls back to ADMIN_ACCESS_CODE if unset.
ADMIN_SESSION_SECRET=

# --- Outbound email ---
# Resend API key; primary transactional-email sender (src/lib/mail.ts).
RESEND_API_KEY=
# From address used for Resend sends, e.g. "NXT//LINK <no-reply@yourdomain.com>".
MAIL_FROM=
# Legacy fallback outbox used only when Resend is unavailable.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_DOMAIN=
ZOHO_API_DOMAIN=
ZOHO_MAIL_ACCOUNT_ID=
ZOHO_FROM_ADDRESS=
ZOHO_MEETING_ZSOID=

# --- Optional integrations (each feature falls back gracefully if absent) ---
# AI writing helpers (vendor description assist, admin co-pilot). Set at most one provider.
GEMINI_API_KEY=
NXT_LINK_LLM_PROVIDER=
# Protects the daily cron routes (profile nudges, invite reminders) from unauthenticated calls.
CRON_SECRET=
# Distributed rate limiting (Upstash Redis); falls back to in-memory limiting if unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# OAuth provider toggles — set to '1' to show that sign-in button.
NEXT_PUBLIC_AUTH_GOOGLE=
NEXT_PUBLIC_AUTH_LINKEDIN=
NEXT_PUBLIC_AUTH_AZURE=
# Free branded Google chooser: browser-safe OAuth Web client ID + rollout flag.
# When disabled/missing, Google uses the existing Supabase-hosted OAuth redirect.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_DIRECT_SIGNIN=
# Demo-account login button; 'true' to allow it outside of production.
ALLOW_DEMO_LOGIN=
NEXT_PUBLIC_ALLOW_DEMO_LOGIN=
# Early-access waitlist notification recipient (first one set wins).
EARLY_ACCESS_NOTIFY_EMAIL=
ADMIN_NOTIFY_EMAIL=
